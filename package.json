{
  "name": "foreai",
  "version": "1.0.0",
  "private": true,
  "description": "ForeAi — AI golf performance app for iOS & Android",
  "scripts": {
    "backend": "npm --prefix backend run dev",
    "mobile": "npm --prefix mobile start",
    "mobile:android": "npm --prefix mobile start -- --android",
    "mobile:ios": "npm --prefix mobile start -- --ios",
    "build": "npm --prefix backend install && npm --prefix backend run build",
    "db:push": "npm --prefix backend run db:push",
    "start": "npm --prefix backend run start"
  }
}

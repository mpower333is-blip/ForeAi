# ForeAi Cloud Functions — optional environment.
# Copy to `.env` (git-ignored) and fill in only what you use. Without any of
# these, the weather report falls back to the Open-Meteo forecast — the same as
# the old backend with no keys set.
#
# NOTE: `firebase deploy --only functions` reads this `.env` (in the functions/
# folder) and ships the values as process.env for the functions at runtime.

# Which organiser emails administer which club. Read by provisionOrganiser:
# on sign-in it sets that account's adminUsers/{uid}.clubKey to the match, which
# is what makes the club-only manage pages (members, tee sheet, competitions,
# news) writable for exactly those accounts. Format: "<clubKey>:<email>",
# comma- or semicolon-separated. Example (add your own test email to try it):
# CLUB_ADMIN_EMAILS="kempton:marcell.laubscher@outlook.com"

# Disable the scheduled lightning watcher entirely.
# LIGHTNING_WATCH=0

# Real detected strikes — The Weather Company (weather.com) Data API.
# TWC_API_KEY=
# TWC_LIGHTNING_ENDPOINT=/v3/wx/lightning/15minute/desktop
# TWC_HOST=https://api.weather.com

# Real detected strikes — Xweather / Aeris.
# XWEATHER_ID=
# XWEATHER_SECRET=

# Official handicap sync — Handicaps Network Africa via the DotGolf ISV API.
# DotGolf issues a Username + Secret Key PER CLUB. Set them and syncClubHna /
# hnaLookup go live; without them both report notConfigured and the roster/app
# keep using manually-entered indexes. See docs/HNA.md.
# HNA_USERNAME=           # DotGolf ISV username for the club
# HNA_SECRET_KEY=         # DotGolf ISV secret/signing key (HS256) — server-only
# Optional overrides (defaults match the ISV docs):
# HNA_API_BASE=http://isvapi.wa.dotgolf.co.uk
# HNA_COUNTRY=wal
# HNA_API_VERSION=v1          # path version; set v3 if the Swagger (labelled V3) uses /v3
# HNA_MEMBERS_PATH=/members   # set if your account's Club Members path differs

{
  "hosting": {
    "public": "clubhouse",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/README*.md"],
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/config.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      }
    ]
  }
}

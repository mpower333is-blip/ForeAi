{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "clubhouse",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/README*.md"],
    "cleanUrls": false,
    "trailingSlash": false,
    "redirects": [
      { "source": "/admin", "destination": "/manage/admin.html", "type": 302 },
      { "source": "/admin.html", "destination": "/manage/admin.html", "type": 302 },
      { "source": "/manage", "destination": "/manage/index.html", "type": 302 },
      { "source": "/portal", "destination": "/manage/index.html", "type": 302 }
    ],
    "headers": [
      {
        "source": "/config.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      }
    ]
  }
}

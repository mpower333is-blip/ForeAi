generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  handicap   Float?

  rounds     Round[]
  clubs      Club[]

  createdAt  DateTime @default(now())
}

model Round {
  id          String   @id @default(uuid())

  userId      String
  user        User @relation(fields:[userId], references:[id])

  courseName  String
  totalScore  Int

  shots       Shot[]

  createdAt   DateTime @default(now())
}

model Shot {
  id               String   @id @default(uuid())

  roundId          String
  round            Round @relation(fields:[roundId], references:[id])

  hole             Int

  club             String
  yardage          Int

  lie              String?
  wind             Int?
  elevation        Int?

  result           String
  dispersion       String?

  expectedStrokes  Float?
  strokesGained    Float?

  createdAt        DateTime @default(now())
}

model Club {
  id           String @id @default(uuid())

  userId       String
  user         User @relation(fields:[userId], references:[id])

  name         String
  avgCarry     Int

  dispersion   Int?

  createdAt    DateTime @default(now())
}
// ---------------------------------------------------------------------------
// Tournaments / golf days — the shared "system" that lets many devices join
// one event, self-register, and see live scores.
// ---------------------------------------------------------------------------

model Tournament {
  id          String   @id @default(uuid())
  code        String   @unique // short human-friendly join code (players use this)
  // Organiser admin PIN. Separate from the public join code: the code lets people
  // JOIN/register + view; changing anything (approve/delete registrations, edit
  // sponsors/settings) requires this PIN. Null = no PIN set yet (open, legacy).
  adminPin    String?
  name        String
  courseId    String            // id from the app's course catalog
  format      String   @default("stroke") // "stroke" | "stableford"
  firstTeeMin Int      @default(480)
  intervalMin Int      @default(10)
  shotgun     Boolean  @default(false)
  cause       String?
  causePhoto  String?  // photo of the person/cause the day supports (data URL)
  // Per-event branding + money (set by the organiser at setup). Makes each event
  // self-contained instead of hard-coding one company's details in the website.
  logo        String?  @db.Text // the event's own logo (data URL)
  banking     String?  @db.Text // banking details block shown on the registration forms
  teamFee     Int?     // entry fee per four-ball team (for office totals + forms)
  holeFee     Int?     // fee per hole sponsor
  // Organiser's custom reminders, pushed to every player's phone as local
  // notifications. JSON array of { offsetMin, title, body } — offsetMin is
  // minutes before the first tee (e.g. 3 days = 4320) for "pay your team fee".
  reminders   Json?

  players       TournamentPlayer[]
  groups        TournamentGroup[]
  scores        TournamentScore[]
  contests      TournamentContest[]
  sponsors      TournamentSponsor[]
  registrations TournamentRegistration[]
  shotMarks     TournamentShotMark[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A submission from the shared online registration form (team entry, hole
// sponsor or prize sponsor). Keeps the full company/contact record for the
// office; players & sponsors are also created so entries import immediately.
model TournamentRegistration {
  id           String @id @default(uuid())

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  type          String  // "team" | "hole" | "prize"
  company       String
  regNumber     String?
  vatNumber     String?
  address       String?
  city          String?
  postalCode    String?
  contactPerson String?
  cell          String?
  email         String?
  payload       String  @db.Text // JSON: type-specific extras (teams/players, holePref, prizes…)
  status        String  @default("new") // office workflow: new | paid | confirmed

  // If this submission created a sponsor (hole/prize), its id — so deleting the
  // submission in the office also removes the sponsor it imported (no orphans).
  sponsorId     String?

  createdAt    DateTime @default(now())
}

model TournamentGroup {
  id           String @id @default(uuid())

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  order        Int // position on the tee sheet (drives the tee time)

  players      TournamentPlayer[]

  createdAt    DateTime @default(now())
}

model TournamentPlayer {
  id           String @id @default(uuid())

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  groupId      String?
  group        TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  name         String
  handicap     Float  @default(0)
  deviceId     String? // the phone that registered this player (for "me")

  // Live presence + position ("who's on the app / where is each team").
  // Updated by a heartbeat from the player's phone while the event is open.
  lastSeen     DateTime? // last heartbeat — recent = on the app right now
  lat          Float?    // last known GPS position (optional, if shared)
  lng          Float?

  scores       TournamentScore[]

  createdAt    DateTime @default(now())
}

model TournamentScore {
  id           String @id @default(uuid())

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  playerId     String
  player       TournamentPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  hole         Int
  strokes      Int

  updatedAt    DateTime @updatedAt

  @@unique([playerId, hole])
}

// On-course side games during a tournament/golf day (closest to the pin,
// longest drive, etc.) tracked across the whole field.
model TournamentContest {
  id           String @id @default(uuid())

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  type         String // "closest" | "longest"
  hole         Int

  results      TournamentContestResult[]

  createdAt    DateTime @default(now())
}

model TournamentContestResult {
  id         String @id @default(uuid())

  contestId  String
  contest    TournamentContest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  playerId   String
  value      Float // yards: distance from pin (closest) or drive length (longest)

  updatedAt  DateTime @updatedAt

  @@unique([contestId, playerId])
}

// Shot marks — the watch (worn on the wrist) posts a mark on each swing: its
// GPS + the selected club + the hole. The phone polls these to log shots
// hands-free even while it sits in the cart. Append-only, lightweight.
model TournamentShotMark {
  id           String @id @default(uuid())

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  playerId     String
  hole         Int?
  club         String?
  lat          Float?
  lng          Float?
  source       String @default("watch") // "watch" | "phone"

  createdAt    DateTime @default(now())

  @@index([tournamentId, playerId, createdAt])
}

// Sponsors for a fundraiser golf day — title/hole/prize/general sponsors shown
// in the app and on the clubhouse board.
model TournamentSponsor {
  id           String @id @default(uuid())

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  name         String
  tier         String // "title" | "hole" | "prize" | "general"
  hole         Int?   // for hole sponsors
  message      String?
  logo         String? // the sponsor's logo as a data URL (uploaded on registration)

  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Club membership + tee-time booking — the "complete package" for a club that
// runs on ForeAi end to end (no external Clubmaster/Teesheet). Everything is
// scoped by `clubKey` (the EXPO_PUBLIC_CLUB flavour, e.g. "kempton") so one
// backend can serve several club apps side by side.
// ---------------------------------------------------------------------------

// Per-club settings: the admin PIN that gates roster/tee-sheet changes, plus
// the shape of the tee sheet (first/last tee, interval, players per slot, how
// far ahead members may book). One row per club.
model ClubSettings {
  clubKey           String  @id            // "kempton"
  name              String                 // display name for admin screens
  adminPin          String?                // gates admin writes (x-admin-pin header)
  courseId          String  @default("")   // course id the tee sheet runs on

  // Tee-sheet shape (minutes past midnight, club-local time)
  firstTeeMin       Int     @default(360)  // 06:00 — first bookable tee
  lastTeeMin        Int     @default(960)  // 16:00 — last bookable tee
  intervalMin       Int     @default(10)   // minutes between tee slots
  slotCapacity      Int     @default(4)    // max players per slot (a four-ball)
  bookingWindowDays Int     @default(14)   // how far ahead members may book
  openDays          String  @default("0,1,2,3,4,5,6") // open weekdays (0=Sun..6=Sat)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// A club member. The OFFICIAL WHS handicap stays with HNA/GolfRSA — we import
// and display the index (handicapIndex), we don't compute it.
model Member {
  id               String    @id @default(uuid())
  clubKey          String    @default("kempton")

  memberNumber     String                     // club membership no. (shown on the card)
  firstName        String
  lastName         String
  email            String?
  cell             String?
  category         String    @default("full")   // full | social | senior | junior | ladies | life | honorary
  status           String    @default("active") // active | suspended | pending | resigned
  joinedAt         DateTime?

  // Handicap (imported from HNA — see /members/sync-hna)
  handicapIndex    Float?
  hnaId            String?                      // Handicaps Network Africa member id
  handicapSyncedAt DateTime?

  // App binding: the phone that claimed this membership (identify + digital card)
  deviceId         String?
  photo            String?   @db.Text          // optional member photo (data URL)

  bookings         TeeBooking[]
  compEntries      CompetitionEntry[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([clubKey, memberNumber])
  @@index([clubKey, lastName])
  @@index([clubKey, email])
}

// A tee-time booking (or an admin block when memberId is null). A slot at a
// given teeAt holds up to ClubSettings.slotCapacity players; a booking takes
// `partySize` of them. Availability = capacity − sum(active partySize at teeAt).
model TeeBooking {
  id           String    @id @default(uuid())
  clubKey      String    @default("kempton")

  teeAt        DateTime                       // the exact tee slot (date + time, UTC)
  courseId     String    @default("")

  memberId     String?                        // who booked (null = admin block)
  member       Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  partySize    Int       @default(1)          // seats this booking takes in the slot
  players      Json?                          // party member names (strings), booker first
  note         String?
  status       String    @default("booked")   // booked | cancelled | blocked

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clubKey, teeAt])
  @@index([memberId])
}

// ---------------------------------------------------------------------------
// Club competitions — the recurring medals / Stableford / betterball days on the
// club calendar. Members enter, submit a card, and see a net/gross/Stableford
// leaderboard. Scored server-side from the course card (par + stroke index) and
// each member's handicap index (imported from HNA). Scoped by clubKey.
// ---------------------------------------------------------------------------

model Competition {
  id                String   @id @default(uuid())
  clubKey           String   @default("kempton")

  name              String                        // "Saturday Medal"
  date              DateTime
  format            String   @default("stableford") // stableford | stroke | betterball
  courseId          String   @default("")
  status            String   @default("open")     // draft | open | closed | results

  // Scoring inputs. The course card is stored on the competition so results are
  // reproducible and the backend needs no course catalogue. Defaults = Kempton.
  pars              Int[]                          // 18 hole pars
  sis               Int[]                          // 18 stroke indexes (1-18)
  handicapAllowance Int      @default(95)          // % of course handicap (WHS medal 95)
  slope             Int      @default(113)         // course slope (113 = neutral)
  courseRating      Float?                         // course rating; defaults to par

  description       String?
  entries           CompetitionEntry[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([clubKey, date])
}

model CompetitionEntry {
  id             String   @id @default(uuid())

  competitionId  String
  competition    Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  // Link to the roster (null for a guest); name + handicap are snapshotted so a
  // result stands even if the member's index later changes.
  memberId       String?
  member         Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  playerName     String
  handicapIndex  Float?                            // snapshot at entry
  playingHandicap Int    @default(0)               // computed from index + allowance

  holeScores     Int[]                             // 18 gross strokes (0 = not played)
  grossTotal     Int?
  netTotal       Int?
  stableford     Int?
  status         String   @default("entered")      // entered | submitted | dq | withdrawn

  teeTime        DateTime?
  groupNo        Int?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([competitionId, memberId])
  @@index([competitionId])
}

// A phone registered to receive lightning push alerts. The background watcher
// (src/lib/lightningWatcher) groups devices by rounded location, checks each
// area's forecast/strikes, and pushes an alert via Expo Push when a storm is a
// danger — so players are warned even with the app closed. `token` is the Expo
// push token; `enabled` flips off when the player turns lightning alerts off.
model PushDevice {
  id        String   @id @default(uuid())
  token     String   @unique // Expo push token (ExponentPushToken[...])
  platform  String?  // "ios" | "android"
  lat       Float?   // last watched location (course centre or live GPS)
  lng       Float?
  enabled   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}
